APP_NAME=API Gateway
APP_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8000

# Must match JWT_SECRET_KEY in the Auth Service and Inventory Service.
JWT_SECRET_KEY=replace-with-one-shared-random-secret
JWT_ALGORITHM=HS256

AUTH_SERVICE_URL=http://localhost:8001
INVENTORY_SERVICE_URL=http://localhost:8002
AI_SERVICE_URL=http://localhost:8003
REQUEST_TIMEOUT=30
