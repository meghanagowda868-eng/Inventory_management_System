# Auth Service database configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=smart_inventory_app
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=smart_inventory_auth

# Use the same JWT settings in the API Gateway, Inventory Service, and AI Service.
JWT_SECRET_KEY=replace-with-one-shared-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

APP_NAME=Auth Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Replace these development values before first startup.
# Startup creates each account only when its email is not already present.
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-admin-password
BOOTSTRAP_MANAGER_EMAIL=manager@gmail.com
BOOTSTRAP_MANAGER_PASSWORD=replace-with-a-local-manager-password
