DB_HOST=localhost
DB_PORT=3306
DB_USER=smart_inventory_app
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=smart_inventory_products

# Must match JWT_SECRET_KEY in the Auth Service and API Gateway.
JWT_SECRET_KEY=replace-with-one-shared-random-secret
JWT_ALGORITHM=HS256

APP_NAME=Inventory Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
